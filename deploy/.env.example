# 数据库配置
DB_HOST=172.18.0.1
DB_PORT=3306
DB_USER=gpt-image
DB_PASSWORD=你的数据库密码
DB_NAME=gpt-image

# GitHub OAuth 配置（需要先在 GitHub 创建 OAuth App）
GITHUB_CLIENT_ID=你的_github_client_id
GITHUB_CLIENT_SECRET=你的_github_client_secret
GITHUB_CALLBACK_URL=https://你的域名/api/auth/github/callback

# Session 密钥（随机字符串，至少32位）
SESSION_SECRET=请生成一个随机字符串

# Redis 配置（可选，不配置则使用内存 session）
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=

# 图片存储
IMAGE_UPLOAD_DIR=/data/images
IMAGE_BASE_URL=https://你的图片域名/images

# CORS 配置（前端应用域名）
CORS_ORIGIN=https://你的应用域名
APP_ORIGIN=https://你的应用域名

# 默认 API 配置（登录用户勾选"使用默认配置"时使用）
DEFAULT_API_URL=https://api.openai.com
DEFAULT_API_KEY=sk-xxx
DEFAULT_MODEL=gpt-5.3-codex
DEFAULT_TIMEOUT=300
DEFAULT_API_FORMAT=responses
